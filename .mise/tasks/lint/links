#!/usr/bin/env bash
#MISE description="Check the local links and anchors in every Markdown file with lychee"
#
# --offline checks only links inside the repository: relative paths and
# #anchors. It skips external URLs, which are slow and fail at random.
#
# Skills usually name their bundled files as inline code, not as links.
# lint:skills checks those paths.

set -euo pipefail
IFS=$'\n\t'

main() {
  cd "$(git rev-parse --show-toplevel)"

  local files=() file
  while read -r file; do
    files+=("$file")
  done < <(git ls-files '*.md')

  lychee --offline --include-fragments --no-progress --root-dir "$PWD" "${files[@]}"
}

main "$@"
